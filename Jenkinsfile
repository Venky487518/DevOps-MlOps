pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code'
            }
        }

        stage('Build') {
            steps {
                echo 'Build started'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing started'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment started'
            }
        }
    }
}